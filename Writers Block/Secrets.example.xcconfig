// Google Drive OAuth build settings for the iOS app.
//
// Copy this file to Secrets.xcconfig, fill the two values below, and keep
// Secrets.xcconfig untracked. The project includes this file, which optionally
// includes Secrets.xcconfig when it exists.

GOOGLE_DRIVE_OAUTH_CLIENT_ID =
GOOGLE_DRIVE_OAUTH_REVERSED_CLIENT_ID =

// Example values for Secrets.xcconfig:
// GOOGLE_DRIVE_OAUTH_CLIENT_ID = your-ios-oauth-client-id.apps.googleusercontent.com
// GOOGLE_DRIVE_OAUTH_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-reversed-client-id

#include? "Secrets.xcconfig"
